# ==========================================
# Internshala Clone Backend Environment Variables
# (Placeholders only - DO NOT commit real secrets)
# ==========================================

# Server Configuration
PORT=5000

# MongoDB Database Connection String
DATABASE_URL=mongodb+srv://<username>:<password>@<cluster-url>/internshala?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_minimum_32_characters

# Razorpay Payment Gateway (Backend Secrets)
RAZORPAY_KEY_ID=rzp_test_yourKeyId
RAZORPAY_KEY_SECRET=yourRazorpayKeySecret

# ==========================================
# Gmail SMTP Configuration
# ==========================================
# 1. EMAIL_USER: Your full Gmail address (e.g., example@gmail.com)
# 2. EMAIL_PASS: A 16-character Google App Password (NOT your regular Gmail login password)
#    How to generate an App Password:
#    a. Go to your Google Account -> Security (https://myaccount.google.com/security)
#    b. Ensure "2-Step Verification" is turned ON.
#    c. Search for "App passwords" (or go to https://myaccount.google.com/apppasswords).
#    d. Create an app name like "Internshala Backend".
#    e. Copy the generated 16-character password and paste it as EMAIL_PASS (spaces can be omitted or included).
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_character_google_app_password

# Optional SMTP Settings (defaults are already tuned for Gmail over IPv4)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_TIMEOUT=10000
