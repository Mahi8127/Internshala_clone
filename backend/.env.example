# ==========================================
# Internshala Clone Backend Environment Variables
# (Placeholders only - DO NOT commit real secrets)
# ==========================================

# Server Configuration
PORT=5000

# MongoDB Database Connection String
DATABASE_URL=mongodb+srv://<username>:<password>@<cluster-url>/internshala?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_minimum_32_characters

# Razorpay Payment Gateway (Backend Secrets)
RAZORPAY_KEY_ID=rzp_test_yourKeyId
RAZORPAY_KEY_SECRET=yourRazorpayKeySecret

# ==========================================
# Email Configuration Options
# Choose ONE of the following options:
# ==========================================

# OPTION 1 (RECOMMENDED FOR RENDER): Brevo HTTPS API (Port 443)
# 1. Sign up at https://app.brevo.com
# 2. Get API key from Settings > SMTP & API > API Keys
# 3. Verify any single sender email (even personal Gmail) under Senders & IP
# 4. Free plan sends up to 300 emails/day to ANY recipient without custom domain DNS setup
EMAIL_PROVIDER=brevo
BREVO_API_KEY=xkeysib-yourBrevoApiKey
BREVO_SENDER_EMAIL=your_verified_email@gmail.com

# OPTION 2: Resend HTTPS API (Port 443)
# 1. Sign up at https://resend.com
# 2. Get API key from API Keys section
# 3. For testing, onboarding@resend.dev only sends to your own signup email.
#    To send to any student/user, verify a custom domain under Domains.
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_yourResendApiKey
# RESEND_FROM=Internshala <onboarding@resend.dev>

# OPTION 3: Nodemailer Direct SMTP (Gmail)
# Note: Render often restricts outbound SMTP ports (465/587).
# If using Gmail, an App Password is required (NOT your personal Google account password).
# Enable 2-Step Verification on Google Account -> App Passwords -> Create "Internshala Backend".
# EMAIL_PROVIDER=smtp
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_16_character_google_app_password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_TIMEOUT=10000
